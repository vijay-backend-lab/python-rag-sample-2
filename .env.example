GEMINI_API_KEY=api_key
ELASTICSEARCH_URL=https://127.0.0.1:9200/
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=password

# Set these to the names in your existing index mapping.
ELASTICSEARCH_INDEX=index_name
ELASTICSEARCH_VECTOR_FIELD=embedding
ELASTICSEARCH_TEXT_FIELD=content

# Optional relevance threshold. Positive number drops hits whose combined
# (BM25 + kNN) score is below it (weak matches return 404). Unset or 0 disables it.
# ELASTICSEARCH_MIN_SCORE=0

# Optional vector similarity for indexes the ingestion API creates when absent.
# One of: cosine (default), dot_product, l2_norm, max_inner_product.
# ELASTICSEARCH_SIMILARITY=cosine
